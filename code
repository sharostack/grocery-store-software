"""Sunshine Mart Inventory & Billing System (SQLite edition)."""

from __future__ import annotations

import os
import smtplib
import ssl
from email.message import EmailMessage

from database import InventoryDatabase


db = InventoryDatabase()
db.initialize()


def print_rows(rows):
    if not rows:
        print("No records found.")
        return
    headers = rows[0].keys()
    widths = {h: max(len(h), *(len(str(row[h])) for row in rows)) for h in headers}
    print(" | ".join(h.ljust(widths[h]) for h in headers))
    print("-+-".join("-" * widths[h] for h in headers))
    for row in rows:
        print(" | ".join(str(row[h]).ljust(widths[h]) for h in headers))


def send_promotional_email(receiver):
    sender, password = os.getenv("SUNSHINE_MART_EMAIL"), os.getenv("SUNSHINE_MART_EMAIL_PASSWORD")
    if not receiver:
        return
    if not sender or not password:
        print("Promotional email skipped: configure SUNSHINE_MART_EMAIL and SUNSHINE_MART_EMAIL_PASSWORD to enable it.")
        return
    email = EmailMessage()
    email["From"], email["To"], email["Subject"] = sender, receiver, "Promotional Email"
    email.set_content("NEW DISCOUNTS AND OFFERS\nVisit Sunshine Mart for our latest offers.")
    with smtplib.SMTP_SSL("smtp.gmail.com", 465, context=ssl.create_default_context()) as smtp:
        smtp.login(sender, password)
        smtp.send_message(email)
    print("Email sent successfully")


def billing():
    print_rows(db.products())
    try:
        item_count = int(input("Enter number of items to be purchased: "))
        if item_count <= 0:
            raise ValueError("Enter a positive number of items.")
        items = [(int(input("Enter item number you want to purchase: ")), int(input("Enter quantity: "))) for _ in range(item_count)]
        customer_email = input("Enter customer's Gmail account (or press Enter to skip email): ").strip()
        sale_id, products, subtotal, vat, total = db.record_sale(items, customer_email)
    except (ValueError, TypeError) as error:
        print(f"Bill was not recorded: {error}")
        return
    product_by_id = {product["product_id"]: product for product in products}
    print("\n*************** WELCOME TO SUNSHINE MART ***************")
    print(f"Bill #{sale_id}")
    for product_id, quantity in items:
        product = product_by_id[product_id]
        print(f"{product['name']}: {quantity} x {product['unit_cost']} Rs = {quantity * product['unit_cost']} Rs")
    print(f"Subtotal: {subtotal} Rs\nVAT (5%): {vat} Rs\nAmount to be paid: {total} Rs")
    send_promotional_email(customer_email)


def inventory():
    print("1. Add new item to inventory\n2. Delete existing item\n3. Display inventory")
    option = input("Select your option: ")
    try:
        if option == "1":
            db.add_product(int(input("Enter unique item number: ")), input("Enter department name: "), input("Enter item name: "), float(input("Enter the cost: ")), int(input("Available quantity: ")))
            print("Product added.")
        elif option == "2":
            db.delete_product(int(input("Enter item number to delete: ")))
            print("Product deleted.")
        elif option == "3":
            print_rows(db.products())
        else:
            print("Number out of range!")
    except (ValueError, TypeError) as error:
        print(f"Inventory change was not made: {error}")


def graphs():
    import matplotlib.pyplot as plt
    print("1. Monthly sales chart\n2. Item sales chart")
    option = input("Select your option: ")
    if option == "1":
        rows = db.monthly_totals()
        plt.pie([row["total"] for row in rows], labels=[row["month_name"] for row in rows], autopct="%1.1f%%", shadow=True)
        plt.title("Monthly sales made by employees")
        plt.show()
    elif option == "2":
        rows = db.inventory_chart_data()
        positions = list(range(len(rows)))
        plt.barh(positions, [row["initial_quantity"] for row in rows], 0.4, label="ordered", color="k")
        plt.barh([p + 0.4 for p in positions], [row["quantity_sold"] for row in rows], 0.4, label="sold", color="c")
        plt.yticks([p + 0.2 for p in positions], [row["name"] for row in rows])
        plt.xlabel("Number of items")
        plt.ylabel("Items")
        plt.title("Item Sales")
        plt.legend(loc=1)
        plt.show()
    else:
        print("No chart displayed")


def main():
    print("*************** WELCOME TO SUNSHINE MART ***************\n")
    print("1. BILL GENERATION\n2. EMPLOYEE DETAILS\n3. INVENTORY\n4. GRAPHS")
    option = input("Select your option: ")
    if option == "1":
        billing()
    elif option == "2":
        if input("Enter password: ") == "Dolphin":
            print_rows(db.employees())
        else:
            print("\nWrong Password! ACCESS DENIED!\n")
            print_rows(db.employees(public_only=True))
    elif option == "3":
        inventory()
    elif option == "4":
        graphs()
    else:
        print("Number shows no output")


if __name__ == "__main__":
    main()
